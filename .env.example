# FUNKNAHT – Konfiguration. Werte nach .env.local kopieren und ausfüllen.

# Inhaberbereich /inhaber: E-Mail-Adresse(n) des Inhaberkontos, kommagetrennt
OWNER_EMAILS=

# Öffentliche Adresse (erst setzen, wenn die Domain feststeht; sonst bleibt die Seite für Suchmaschinen gesperrt)
SITE_URL=
APP_URL=http://127.0.0.1:3000
# Nur auf true setzen, wenn ein Proxy (z. B. nginx) X-Forwarded-For/X-Real-IP selbst setzt
TRUST_PROXY=false

# Zeitplan (Terminerinnerungen, Überwachung, Bereinigung): mindestens 24 Zeichen, z. B. openssl rand -hex 32
CRON_SECRET=
# Kurzname deiner eigenen Buchungsseite /buchen/<name> (für „Termin buchen“ in Anfragen)
FUNKNAHT_BOOKING_SLUG=

# Angaben für Impressum und Datenschutz (nach Änderung neu bauen)
COMPANY_OWNER=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_VAT_ID=

# E-Mail-Versand (Kontaktformular, Buchungs- und Anfrage-Benachrichtigungen)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
# Optional statt Gmail: eigener SMTP-Server
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# FUNKNAHT AI (Kunden-Assistent im Hilfe-Portal und Workspace-Assistent im Inhaberbereich)
# Start: Groq (kostenlose Stufe), Schlüssel unter console.groq.com -> API Keys.
AI_PROVIDER=groq
GROQ_API_KEY=
# Modell (Standard für Groq: openai/gpt-oss-120b). Preise in US-Dollar je 1 Mio. Tokens für die Kostenanzeige.
AI_MODEL=
AI_PRICE_INPUT=
AI_PRICE_OUTPUT=
# EU-Alternative: AI_PROVIDER=mistral und MISTRAL_API_KEY=...
# Jeder OpenAI-kompatible Dienst (z. B. IONOS AI Model Hub, Rechenzentrum Deutschland):
#   AI_PROVIDER=compatible, AI_BASE_URL=https://..., AI_API_KEY=..., AI_MODEL=..., AI_REGION=Deutschland
#   AI_PROVIDER_LEGAL=Name des Anbieters für die Datenschutzerklärung
# Einzeln abschalten: AI_CUSTOMER=off bzw. AI_WORKSPACE=off
# Nur zum Ausprobieren ohne Schlüssel (antwortet nicht wirklich): FUNKNAHT_AI_MOCK=1

# Stripe: zuerst mit Testschlüsseln (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BETRIEB=
ALLOW_LIVE_BILLING=false
