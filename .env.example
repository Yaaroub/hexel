
# FUNKNAHT – Konfiguration. Werte nach .env.local kopieren und ausfüllen.

# Inhaberbereich /inhaber: E-Mail-Adresse(n) des Inhaberkontos, kommagetrennt
OWNER_EMAILS=

# Öffentliche Adresse (erst setzen, wenn die Domain feststeht; sonst bleibt die Seite für Suchmaschinen gesperrt)
SITE_URL=
APP_URL=http://127.0.0.1:3000
# Nur auf true setzen, wenn ein Proxy (z. B. nginx) X-Forwarded-For/X-Real-IP selbst setzt
TRUST_PROXY=false

# Angaben für Impressum und Datenschutz (nach Änderung neu bauen)
COMPANY_OWNER=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_VAT_ID=

# E-Mail-Versand (Kontaktformular, Buchungs- und Anfrage-Benachrichtigungen)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
# Optional statt Gmail: eigener SMTP-Server
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# KI-Assistent im Hilfe-Portal
OPENAI_API_KEY=
PORTAL_AI_PROVIDER=openai
PORTAL_AI_MODEL=gpt-4.1-mini

# Stripe: zuerst mit Testschlüsseln (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BETRIEB=
ALLOW_LIVE_BILLING=false
