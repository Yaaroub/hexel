# FUNKNAHT – Server-Konfiguration
# Diese Datei auf dem Server nach /opt/funknaht/.env.local kopieren und ausfüllen:
#   cp deploy/env.production.beispiel .env.local && nano .env.local
# Hier nie echte Werte eintragen und diese Datei nie mit Werten committen.

NODE_ENV=production

# Inhaberbereich /inhaber: E-Mail-Adresse deines Inhaberkontos
OWNER_EMAILS=

# Deine Domain, mit https:// und ohne Schrägstrich am Ende
SITE_URL=https://funknaht.de
APP_URL=https://funknaht.de
# nginx setzt die echte Besucher-IP, deshalb true
TRUST_PROXY=true

# Zeitplan für Terminerinnerungen, Überwachung und Datenbereinigung.
# Mindestens 24 Zeichen. Erzeugen mit:  openssl rand -hex 32
CRON_SECRET=

# Kurzname deines eigenen Betriebskontos für /buchen/<name>
# (steht in deinem Betriebsbereich unter „Buchungsseite“)
FUNKNAHT_BOOKING_SLUG=

# Impressum, Datenschutz, Belege
COMPANY_OWNER=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_VAT_ID=
# Profile für Google und KI-Suchen, kommagetrennt (Google-Unternehmensprofil, LinkedIn …)
COMPANY_PROFILES=
# Für den AVV: Hosting- und E-Mail-Anbieter mit Sitz, z. B. „Hetzner Online GmbH, Gunzenhausen, Server in Nürnberg“
HOSTING_PROVIDER=
MAIL_PROVIDER=
# Erst auf true setzen, wenn AGB, Widerruf und AVV rechtlich geprüft sind
LEGAL_REVIEWED=false

# E-Mail-Versand (eigener SMTP-Server empfohlen, z. B. vom Webhoster)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# FUNKNAHT AI (Kunden-Assistent im Hilfe-Portal und Workspace-Assistent im Inhaberbereich)
# Start: Groq (kostenlose Stufe), Schlüssel unter console.groq.com -> API Keys.
AI_PROVIDER=groq
GROQ_API_KEY=
# Modell (Standard für Groq: openai/gpt-oss-120b). Preise in US-Dollar je 1 Mio. Tokens für die Kostenanzeige.
AI_MODEL=
AI_PRICE_INPUT=
AI_PRICE_OUTPUT=
# EU-Alternative: AI_PROVIDER=mistral und MISTRAL_API_KEY=...
# Jeder OpenAI-kompatible Dienst (z. B. IONOS AI Model Hub, Rechenzentrum Deutschland):
#   AI_PROVIDER=compatible, AI_BASE_URL=https://..., AI_API_KEY=..., AI_MODEL=..., AI_REGION=Deutschland
#   AI_PROVIDER_LEGAL=Name des Anbieters für die Datenschutzerklärung
# Einzeln abschalten: AI_CUSTOMER=off bzw. AI_WORKSPACE=off
# Nur zum Ausprobieren ohne Schlüssel (antwortet nicht wirklich): FUNKNAHT_AI_MOCK=1

# Stripe (optional, zuerst Testschlüssel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BETRIEB=
ALLOW_LIVE_BILLING=false
