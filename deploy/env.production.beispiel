# FUNKNAHT – Server-Konfiguration
# Diese Datei auf dem Server nach /opt/funknaht/.env.local kopieren und ausfüllen:
#   cp deploy/env.production.beispiel .env.local && nano .env.local
# Hier nie echte Werte eintragen und diese Datei nie mit Werten committen.

NODE_ENV=production

# Inhaberbereich /inhaber: E-Mail-Adresse deines Inhaberkontos
OWNER_EMAILS=

# Deine Domain, mit https:// und ohne Schrägstrich am Ende
SITE_URL=https://funknaht.de
APP_URL=https://funknaht.de
# nginx setzt die echte Besucher-IP, deshalb true
TRUST_PROXY=true

# Zeitplan für Terminerinnerungen, Überwachung und Datenbereinigung.
# Mindestens 24 Zeichen. Erzeugen mit:  openssl rand -hex 32
CRON_SECRET=

# Kurzname deines eigenen Betriebskontos für /buchen/<name>
# (steht in deinem Betriebsbereich unter „Buchungsseite“)
FUNKNAHT_BOOKING_SLUG=

# Impressum, Datenschutz, Belege
COMPANY_OWNER=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_VAT_ID=

# E-Mail-Versand (eigener SMTP-Server empfohlen, z. B. vom Webhoster)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# KI-Assistent (optional). Neuen Schlüssel anlegen, den alten widerrufen.
OPENAI_API_KEY=
PORTAL_AI_PROVIDER=openai
PORTAL_AI_MODEL=gpt-4.1-mini

# Stripe (optional, zuerst Testschlüssel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_BETRIEB=
ALLOW_LIVE_BILLING=false
