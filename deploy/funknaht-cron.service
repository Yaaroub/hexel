# /etc/systemd/system/funknaht-cron.service
# Ruft alle 5 Minuten die geplanten Aufgaben auf (Erinnerungen, Überwachung, Bereinigung).
[Unit]
Description=FUNKNAHT geplante Aufgaben
After=funknaht.service

[Service]
Type=oneshot
User=funknaht
EnvironmentFile=/opt/funknaht/.env.local
ExecStart=/bin/sh -c 'curl -fsS -m 60 -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron > /dev/null'
